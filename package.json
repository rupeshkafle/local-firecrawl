{
  "name": "local-firecrawl",
  "version": "1.0.2",
  "description": "Lightweight local Firecrawl-compatible scraper",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "start:server-only": "node src/server.js",
    "postinstall": "playwright install chromium || echo 'Warning: automatic Playwright Chromium install failed. Run: npx playwright install chromium'",
    "install:playwright": "playwright install chromium",
    "search": "python3 scripts/search_server.py 3003"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "p-limit": "^5.0.0",
    "p-retry": "^6.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.47.2"
  }
}
